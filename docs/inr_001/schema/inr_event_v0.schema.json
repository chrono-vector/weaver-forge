{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INR Event v0 (r2 local capture export; never PASS-capable on its own)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inr_event_id",
    "target_sha",
    "accepted_target_profile_binding",
    "accepted_origin_reference_binding",
    "challenge",
    "ledger_reservation_entry_sha256",
    "lifecycle",
    "git_probe",
    "measurements",
    "capture_records",
    "blocked_reasons",
    "failure_reasons",
    "verification",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "inr.event.v0.r2"
    },
    "inr_event_id": {
      "type": "string",
      "minLength": 1
    },
    "target_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "accepted_target_profile_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_profile_id",
        "target_profile_digest"
      ],
      "properties": {
        "target_profile_id": {
          "type": "string"
        },
        "target_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "accepted_origin_reference_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_reference_set_id",
        "origin_reference_set_digest"
      ],
      "properties": {
        "origin_reference_set_id": {
          "type": "string"
        },
        "origin_reference_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "challenge": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledger_reservation_entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "EVENT_START",
        "BINDINGS_RECORDED"
      ],
      "properties": {
        "EVENT_START": {
          "type": "integer"
        },
        "BINDINGS_RECORDED": {
          "type": "integer"
        },
        "ENVIRONMENT_RECORDED": {
          "type": "integer"
        },
        "ACQUISITION_VERIFIED": {
          "type": "integer"
        },
        "FREEZE_START": {
          "type": "integer"
        },
        "COMMAND_EXECUTION_BEGIN": {
          "type": "integer"
        },
        "EXECUTION_COMPLETE": {
          "type": "integer"
        },
        "POST_MEASUREMENT": {
          "type": "integer"
        },
        "CAPTURE_COMPLETE": {
          "type": "integer"
        },
        "EVENT_COMPLETE": {
          "type": "integer"
        }
      }
    },
    "git_probe": {
      "type": "object"
    },
    "measurements": {
      "type": "object"
    },
    "capture_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "command_id",
          "sequence",
          "event_id",
          "challenge",
          "case_nonce",
          "argv",
          "popen_args",
          "cwd",
          "env_path",
          "env_git",
          "child_pid",
          "return_code",
          "start_ns",
          "end_ns",
          "stdout_base64",
          "stderr_base64",
          "stdout_sha256",
          "stderr_sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer"
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "challenge": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "case_nonce": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "popen_args": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "env_path": {
            "type": "string"
          },
          "env_git": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "child_pid": {
            "type": "integer"
          },
          "return_code": {
            "type": "integer"
          },
          "start_ns": {
            "type": "integer"
          },
          "end_ns": {
            "type": "integer"
          },
          "stdout_base64": {
            "type": "string"
          },
          "stderr_base64": {
            "type": "string"
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "derived_result",
        "pass_allowed",
        "local_controls_result",
        "components",
        "blocked",
        "fail",
        "unconfirmed",
        "nonclaims"
      ],
      "properties": {
        "schema_version": {
          "const": "inr.verifier.result.v0.r2"
        },
        "derived_result": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCONFIRMED",
            "BLOCKED"
          ]
        },
        "pass_allowed": {
          "type": "boolean"
        },
        "local_controls_result": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCONFIRMED",
            "BLOCKED"
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trusted_configuration",
            "challenge_ledger",
            "git_runtime",
            "acquisition",
            "python_policy",
            "child_execution_binding",
            "argv_binding",
            "module_identity",
            "refusal_semantics",
            "non_origin",
            "shared_state_absence",
            "all_writer_isolation"
          ],
          "properties": {
            "trusted_configuration": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "challenge_ledger": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "git_runtime": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "acquisition": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "python_policy": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "child_execution_binding": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "argv_binding": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "module_identity": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "refusal_semantics": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "non_origin": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "shared_state_absence": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            },
            "all_writer_isolation": {
              "enum": [
                "PASS",
                "FAIL",
                "UNCONFIRMED",
                "BLOCKED"
              ]
            }
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unconfirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nonclaims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
