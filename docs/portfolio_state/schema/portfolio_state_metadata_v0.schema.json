{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weaver.portfolio_state_metadata.v0",
  "title": "Portfolio State Metadata v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "portfolio_state_id",
    "subject_scope_id",
    "source_records",
    "earned",
    "not_yet_earned",
    "validation_debt",
    "epistemic_ceiling",
    "counterexamples",
    "assumptions",
    "replayability",
    "revision_provenance",
    "limitations",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": "weaver.portfolio_state_metadata.v0"},
    "portfolio_state_id": {"$ref": "#/$defs/nonempty"},
    "subject_scope_id": {"$ref": "#/$defs/nonempty"},
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_record"}
    },
    "earned": {"type": "array", "items": {"$ref": "#/$defs/earned"}},
    "not_yet_earned": {"type": "array", "items": {"$ref": "#/$defs/not_yet"}},
    "validation_debt": {"type": "array", "items": {"$ref": "#/$defs/debt"}},
    "epistemic_ceiling": {"$ref": "#/$defs/ceiling"},
    "counterexamples": {"type": "array", "items": {"$ref": "#/$defs/counterexample"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "replayability": {"$ref": "#/$defs/replayability"},
    "revision_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/revision"}
    },
    "limitations": {"$ref": "#/$defs/strings"},
    "nonclaims": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_id", "path", "git_commit", "record_kind"],
      "properties": {
        "source_record_id": {"$ref": "#/$defs/nonempty"},
        "path": {"$ref": "#/$defs/nonempty"},
        "git_commit": {"$ref": "#/$defs/sha"},
        "record_kind": {
          "enum": ["human_final", "verification", "wacp_binding", "ecp_record", "counterexample", "remediation"]
        }
      }
    },
    "earned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "description", "status", "source_claim_refs"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/nonempty"},
        "description": {"$ref": "#/$defs/nonempty"},
        "status": {"const": "EARNED"},
        "source_claim_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        }
      }
    },
    "not_yet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "description", "status", "source_record_ids", "blocking_debt_ids"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/nonempty"},
        "description": {"$ref": "#/$defs/nonempty"},
        "status": {"const": "NOT_YET_EARNED"},
        "source_record_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "blocking_debt_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
      }
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["debt_id", "description", "source_reference", "status", "blocked_claims", "closure_condition"],
      "properties": {
        "debt_id": {"$ref": "#/$defs/nonempty"},
        "description": {"$ref": "#/$defs/nonempty"},
        "source_reference": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["OPEN", "CLOSED"]},
        "blocked_claims": {"$ref": "#/$defs/strings"},
        "closure_condition": {"$ref": "#/$defs/nonempty"}
      }
    },
    "ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling_id", "description", "source_record_id", "verbatim"],
      "properties": {
        "ceiling_id": {"$ref": "#/$defs/nonempty"},
        "description": {"$ref": "#/$defs/nonempty"},
        "source_record_id": {"$ref": "#/$defs/nonempty"},
        "verbatim": {"$ref": "#/$defs/nonempty"}
      }
    },
    "counterexample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counterexample_id", "description", "status", "source_record_ids", "outcome_history"],
      "properties": {
        "counterexample_id": {"$ref": "#/$defs/nonempty"},
        "description": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["OPEN", "REMEDIATED"]},
        "source_record_ids": {"$ref": "#/$defs/source_ids"},
        "outcome_history": {
          "oneOf": [
            {"const": ["FAIL"]},
            {"const": ["FAIL", "REMEDIATION", "PASS"]}
          ]
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "description", "status", "source_record_ids"],
      "properties": {
        "assumption_id": {"$ref": "#/$defs/nonempty"},
        "description": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["UNKNOWN", "VERIFIED", "DISCHARGED"]},
        "source_record_ids": {"$ref": "#/$defs/source_ids"}
      }
    },
    "replayability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_record_ids", "independent_reproduction"],
      "properties": {
        "status": {"enum": ["UNKNOWN", "RECORDED", "REPLAYABLE", "NOT_REPLAYABLE"]},
        "source_record_ids": {"$ref": "#/$defs/source_ids"},
        "independent_reproduction": {"const": "NOT_CLAIMED"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "git_commit", "source_record_ids"],
      "properties": {
        "revision_id": {"$ref": "#/$defs/nonempty"},
        "git_commit": {"$ref": "#/$defs/sha"},
        "source_record_ids": {"$ref": "#/$defs/source_ids"}
      }
    }
  }
}
