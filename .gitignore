# Weaver Forge public-core containment.
# These patterns are accidental-publication containment, not access control.
# They apply prospectively. Already-tracked historical files remain tracked.
# See PUBLIC_PRIVATE_ARTIFACT_ROUTING.md.

# Python / cache / local generated
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
credentials.json
secrets.json

# Real package / archive outputs
*.zip
*.tar
*.tar.gz
*.tgz

# Owner-local / private operational outputs
/owner-local/
/private-artifacts/
/local-results/
**/ingress-results/

# Logs / owner run artifacts
*.log

# Local phase / operator scratch (never publish as product evidence)
phase5_runs/
phase6_runs/
phase61_runs/
phase*_operator_request.json
phase*_third_party_target/
**/_negative_paths/
examples/**/runs/

# Temporary stdout / disposable copies
*.stdout.txt
*.stderr.txt
*_disposable_*/
.tmp/
.temp/
